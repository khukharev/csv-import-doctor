APP_NAME="CSV Import Doctor"
APP_AUTHOR="Student"
APP_LOG_LEVEL=INFO

# Input limits used by the CSV core and POST /inspect.
CSV_MAX_BYTES=2097152
CSV_MAX_ROWS=10000
# Keep NBSP by default. true removes it ONLY at cell/header edges.
CSV_TRIM_NBSP=false

# Output quoting for cleaned.csv: all (default) or minimal.
CSV_QUOTING=all
# Default report view: full (default) or compact. Query report_view overrides it.
CSV_REPORT_VIEW=full
